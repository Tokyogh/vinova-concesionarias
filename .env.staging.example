# ES: Documenta variables de ejemplo para .env.staging.example; no contiene secretos reales.
# EN: Documents example variables for .env.staging.example; it contains no real secrets.
# Vinova Pro v1.0.1 — plantilla segura para staging.
# Copiar como .env.staging y reemplazar todos los marcadores. No versionar el archivo resultante.
COMPOSE_PROJECT_NAME=vinova_pro_staging
COMPOSE_PROFILES=local-db
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DEBUG=False
ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
VINOVA_HEALTHCHECK_HOST=staging.example.com
VINOVA_ENVIRONMENT=staging
VINOVA_ENV_FILE=.env.staging

# ES: Las variables siguientes agrupan conexión y límites; son ejemplos sin secretos reales.
# EN: The following variables group connectivity and limits; they are examples without real secrets.
POSTGRES_DB=vinova_pro_staging
POSTGRES_USER=vinova_staging
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# DATABASE_URL debe repetir exactamente POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB.
DB_CONN_MAX_AGE=60
DATABASE_URL=postgres://vinova_staging:CHANGE_ME_POSTGRES@db:5432/vinova_pro_staging

REDIS_PASSWORD=CHANGE_ME_REDIS
# Las tres URLs siguientes deben repetir exactamente REDIS_PASSWORD.
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS@redis:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_BACKUP_QUEUE=backups
CELERY_WEBHOOK_QUEUE=webhooks
CELERY_QA_QUEUE=qa
CELERY_VISIBILITY_TIMEOUT=14400
VINOVA_REQUIRE_CELERY_READY=True
VINOVA_BACKUP_SYNC_FALLBACK=False
VINOVA_AUTOMATED_BACKUPS_ENABLED=False
VINOVA_MODULE_POST_SALES_ENABLED=False

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Vinova Pro Staging <no-reply@staging.example.com>
SERVER_EMAIL=Vinova Pro Staging <errors@staging.example.com>

PRIVATE_STORAGE_ROOT=/app/private
STORAGE_BACKEND=local
PRIVATE_STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_HTTP_TIMEOUT_SECONDS=15
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=auto
S3_ADDRESSING_STYLE=path
S3_PRIVATE_PREFIX=vinova/private
S3_SIGNED_URL_EXPIRE_SECONDS=300
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=vinova-pro@1.0.1
SENTRY_TRACES_SAMPLE_RATE=0.0

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=28800
VINOVA_TRUST_PROXY_HEADERS=True
VINOVA_API_DOCS_PUBLIC=False
VINOVA_MAX_UPLOAD_MB=25
VINOVA_ZIP_MAX_ENTRIES=1000
VINOVA_ZIP_MAX_UNCOMPRESSED_MB=100
VINOVA_ZIP_MAX_COMPRESSION_RATIO=200
VINOVA_IMPORT_MAX_ROWS=10000
VINOVA_IMPORT_MAX_COLUMNS=100
VINOVA_ARCHIVE_MAX_MEMBERS=100000
VINOVA_ARCHIVE_MAX_UNCOMPRESSED_MB=51200
VINOVA_PUBLIC_FORM_MAX_SUBMISSIONS=8
VINOVA_PUBLIC_FORM_WINDOW_SECONDS=3600

LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

NGINX_TLS_ENABLED=True
NGINX_SERVER_NAME=staging.example.com
VINOVA_SHARED_ASSETS_GID=101
NGINX_CLIENT_MAX_BODY_SIZE=25m
NGINX_PROXY_READ_TIMEOUT=120s
NGINX_FORWARDED_PROTO=http
NGINX_TRUSTED_PROXY_CIDR=
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem
VINOVA_WAIT_TIMEOUT=180
VINOVA_WAIT_INTERVAL=2

VINOVA_API_TOKEN_PEPPER=CHANGE_ME_WITH_AN_INDEPENDENT_RANDOM_VALUE_OF_32_OR_MORE_CHARACTERS
VINOVA_API_CLIENT_DEFAULT_RATE=600/hour
VINOVA_IDEMPOTENCY_TTL_HOURS=24
VINOVA_WEBHOOK_ALLOW_PRIVATE_NETWORKS=False

# Deployment Smoke Bot. Las credenciales se inyectan solo en el runner y no se guardan aquí.
VINOVA_SMOKE_BASE_URL=https://staging.example.com
VINOVA_SMOKE_MODE=staging
VINOVA_SMOKE_TIMEOUT=30
VINOVA_SMOKE_RETRIES=1
VINOVA_SMOKE_REPORT_DIR=private/qa_reports
VINOVA_SMOKE_ALLOW_WRITE=False
VINOVA_SMOKE_ALLOW_ROLE_PROVISION=false
VINOVA_SMOKE_ROLE_CREDENTIALS_FILE=
