# ES: Documenta variables de ejemplo para .env.example; no contiene secretos reales.
# EN: Documents example variables for .env.example; it contains no real secrets.
# Vinova Pro v1.0.1 - ejemplo local. Copiar como .env y cambiar credenciales.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
VINOVA_HEALTHCHECK_HOST=localhost

POSTGRES_DB=vinova_pro
POSTGRES_USER=vinova
# ES: Las variables siguientes agrupan conexión y límites; son ejemplos sin secretos reales.
# EN: The following variables group connectivity and limits; they are examples without real secrets.
POSTGRES_PASSWORD=vinova
DB_CONN_MAX_AGE=60
DATABASE_URL=postgres://vinova:vinova@db:5432/vinova_pro

REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BROKER_CONNECTION_MAX_RETRIES=20
CELERY_VISIBILITY_TIMEOUT=14400
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_BACKUP_QUEUE=backups
CELERY_WEBHOOK_QUEUE=webhooks
CELERY_QA_QUEUE=qa
VINOVA_CELERY_HEARTBEAT_INTERVAL=60
VINOVA_CELERY_HEARTBEAT_MAX_AGE=180
VINOVA_REQUIRE_CELERY_READY=False

# En local puede facilitar pruebas. En producción debe ser False.
VINOVA_BACKUP_SYNC_FALLBACK=True
VINOVA_AUTOMATED_BACKUPS_ENABLED=False
VINOVA_MODULE_POST_SALES_ENABLED=False
VINOVA_BACKUP_SCHEDULER_INTERVAL=300
VINOVA_BACKUP_PUBLISH_RETRY=True
VINOVA_BACKUP_PUBLISH_MAX_RETRIES=3
VINOVA_BACKUP_SOFT_TIME_LIMIT=3300
VINOVA_BACKUP_HARD_TIME_LIMIT=3600
VINOVA_BACKUP_TASK_RATE_LIMIT=2/h

# QA de Vinova Pro 2.0.0. El Compose QA habilita el ejecutor de forma explícita.
VINOVA_QA_EXECUTION_ENABLED=False
VINOVA_QA_AUTOMATED_ENABLED=False
VINOVA_QA_AUTOMATED_MIN_INTERVAL_HOURS=20
VINOVA_QA_MAX_CONCURRENT_RUNS=1
VINOVA_QA_STALE_AFTER_MINUTES=150
VINOVA_QA_RETENTION_DAYS=90
VINOVA_QA_ENVIRONMENT=application
VINOVA_QA_REPORT_ROOT=/app/private/qa_reports
VINOVA_QA_SOFT_TIME_LIMIT=6900
VINOVA_QA_HARD_TIME_LIMIT=7200
VINOVA_QA_TASK_RATE_LIMIT=4/h

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Vinova Pro <no-reply@localhost>
SERVER_EMAIL=Vinova Pro <errors@localhost>

STORAGE_BACKEND=local
PRIVATE_STORAGE_BACKEND=local
PRIVATE_STORAGE_ROOT=/app/private
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_HTTP_TIMEOUT_SECONDS=15
# Clave pública restringida por dominio para el mapa de Instituciones. Puede quedar vacía.
MAPTILER_PUBLIC_KEY=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=auto
S3_ADDRESSING_STYLE=path
S3_PRIVATE_PREFIX=vinova/private
S3_SIGNED_URL_EXPIRE_SECONDS=300
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=vinova-pro@2.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
VINOVA_SESSION_ABSOLUTE_MINUTES=480
VINOVA_TRUST_PROXY_HEADERS=False
VINOVA_API_DOCS_PUBLIC=True
VINOVA_MAX_UPLOAD_MB=25
VINOVA_ZIP_MAX_ENTRIES=1000
VINOVA_ZIP_MAX_UNCOMPRESSED_MB=100
VINOVA_ZIP_MAX_COMPRESSION_RATIO=200
VINOVA_IMPORT_MAX_ROWS=10000
VINOVA_IMPORT_MAX_COLUMNS=100
VINOVA_ARCHIVE_MAX_MEMBERS=100000
VINOVA_ARCHIVE_MAX_UNCOMPRESSED_MB=51200
VINOVA_PUBLIC_FORM_MAX_SUBMISSIONS=8
VINOVA_PUBLIC_FORM_WINDOW_SECONDS=3600
VINOVA_COOKIE_NOTICE_VERSION=2026-10-16
VINOVA_COOKIE_CONSENT_AGE=15552000
VINOVA_PRIVACY_NOTICE_VERSION=draft-2026-10-16
VINOVA_TERMS_VERSION=draft-2026-10-16
VINOVA_PUBLIC_PARTS_CATALOG_ENABLED=True
VINOVA_VEHICLE_PLATE_PATTERN=^[A-Z]{2,3}[- ]?\d{3,4}$

VINOVA_LOGIN_MAX_ATTEMPTS=5
VINOVA_LOGIN_LOCK_MINUTES=15

LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
GUNICORN_PRELOAD=False

NGINX_TLS_ENABLED=False
NGINX_SERVER_NAME=localhost
VINOVA_SHARED_ASSETS_GID=101
NGINX_CLIENT_MAX_BODY_SIZE=25m
NGINX_PROXY_READ_TIMEOUT=120s
NGINX_FORWARDED_PROTO=http
NGINX_TRUSTED_PROXY_CIDR=
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
VINOVA_WAIT_TIMEOUT=120

# API e integraciones v0.21
# Usa un valor aleatorio independiente en producción; cambiarlo invalida los tokens API existentes.
VINOVA_API_TOKEN_PEPPER=change-me-with-an-independent-api-token-pepper
VINOVA_API_CLIENT_DEFAULT_RATE=600/hour
VINOVA_IDEMPOTENCY_TTL_HOURS=24
VINOVA_WEBHOOK_ALLOW_PRIVATE_NETWORKS=False

# Deployment Smoke Bot (runner externo; no usar secretos reales en este archivo)
VINOVA_SMOKE_BASE_URL=
VINOVA_SMOKE_USERNAME=
VINOVA_SMOKE_PASSWORD=
VINOVA_SMOKE_MODE=production
VINOVA_SMOKE_TIMEOUT=30
VINOVA_SMOKE_RETRIES=1
VINOVA_SMOKE_REPORT_DIR=private/qa_reports
VINOVA_SMOKE_ALLOW_WRITE=False
VINOVA_SMOKE_DEMO_CONFIRM=
VINOVA_SMOKE_RETAIN_CONFIRM=

# Deployment Smoke Bot · matriz de roles (solo local/staging/demo)
VINOVA_SMOKE_ALLOW_ROLE_PROVISION=false
VINOVA_SMOKE_ROLE_CREDENTIALS_FILE=
