# ES: Excluye secretos, datos locales, artefactos y la referencia LITE del contexto de imagen.
# EN: Exclude secrets, local data, artifacts and the LITE reference from the image context.
.git
.env
.env.*
!.env.example
!.env.production.example
!.env.staging.example
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
test.sqlite3
*.sqlite3
media/*
!media/.gitkeep
private/*
!private/.gitkeep
staticfiles
web_carros
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep
logs/*
!logs/.gitkeep
run/*
!run/.gitkeep
celerybeat-schedule
backups
node_modules
security-reports
.trivy-cache
nd.txt
trivy-reports
qa-reports
qa_reports
playwright-report
test-results
